# ==============================================================================
# SAHAAYALEARN BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# AI Provider Selection: 'groq' (primary) or 'gemini' (secondary)
AI_PROVIDER=groq

# Groq API (Primary AI Reasoning Engine with GPT-OSS Models)
# Sign up at: https://console.groq.com/
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Google Gemini AI (Optional Secondary Fallback)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Sarvam AI (Indian-Language Speech Engine - Saaras STT & Bulbul TTS)
# Get your API key from Sarvam AI: https://docs.sarvam.ai/
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash

# Voice Pipeline Settings
VOICE_PROVIDER_STT=sarvam
VOICE_PROVIDER_TTS=sarvam
VOICE_AUTO_SPEAK=true
VOICE_DEFAULT_LANGUAGE=kn-IN
VOICE_DEFAULT_PACE=1.0
VOICE_SESSION_TIMEOUT=300
VOICE_AUDIO_RETENTION=false

# Supabase (PostgreSQL + pgvector + Auth + Storage)
# Get your credentials from Supabase: https://supabase.com/
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Optional Monitoring
SENTRY_DSN=
